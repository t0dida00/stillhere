    "Location (optional)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí (không bắt buộc)"
          }
        }
      }
    },
    "Location access is off for StillAlive?. You can allow it in the iOS Settings app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "StillAlive? chưa được phép dùng vị trí. Bạn có thể cho phép trong ứng dụng Cài đặt của iOS."
          }
        }
      }
    },
    "Location access was not allowed. You can change this later in Settings.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa được cho phép dùng vị trí. Bạn có thể đổi sau trong Cài đặt."
          }
        }
      }
    },
    "Location is off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí đang tắt"
          }
        }
      }
    },
    "Location is off in Settings, so nothing is shared until you turn it on there.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí đang tắt trong Cài đặt, nên chưa có gì được chia sẻ cho đến khi bạn bật lên."
          }
        }
      }
    },
    "Location is off, so this isn't updated. Turn it on in Settings.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí đang tắt nên thông tin này không được cập nhật. Hãy bật trong Cài đặt."
