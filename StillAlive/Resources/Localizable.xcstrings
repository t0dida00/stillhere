            "state": "translated",
            "value": "Khó"
          }
        }
      }
    },
    "Invitations to join someone's circle. Accepting lets them see your check-ins and you see theirs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời mời tham gia nhóm của ai đó. Đồng ý để họ thấy lần điểm danh của bạn và bạn thấy của họ."
          }
        }
      }
    },
    "Invite code": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã mời"
          }
        }
      }
    },
    "Invite sent": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi lời mời"
