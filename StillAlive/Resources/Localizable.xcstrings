{
  "sourceLanguage": "en",
  "strings": {
    "%@ doesn't want to share their location.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không muốn chia sẻ vị trí."
          }
        }
      }
    },
    "%@ hasn't checked in with a location yet.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chưa điểm danh kèm vị trí nào."
          }
        }
      }
    },
    "%@ missed a check-in": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã bỏ lỡ một lần điểm danh"
          }
        }
      }
    },
    "%@ will see where you checked in and where you last used the app. You can turn this off anytime.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ thấy nơi bạn điểm danh và nơi bạn dùng ứng dụng gần nhất. Bạn có thể tắt bất cứ lúc nào."
          }
        }
      }
    },
    "%@: %lld of %lld done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$lld of %3$lld done"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: xong %lld/%lld"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld min": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld phút"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld"
          }
        }
      }
    },
    "+84 912 345 678": {
      "shouldTranslate": false
    },
    "3D": {
      "shouldTranslate": false
    },
    "3D off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt 3D"
          }
        }
      }
    },
    "3D on": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật 3D"
          }
        }
      }
    },
    "@username": {
      "shouldTranslate": false
    },
    "A tiny daily check-in so the people you love know you're okay. No account needed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần điểm danh nhỏ mỗi ngày để người thân biết bạn vẫn ổn. Không cần tài khoản."
          }
        }
      }
    },
    "ABCD1234": {
      "shouldTranslate": false
    },
    "Accept": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng ý"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm"
          }
        }
      }
    },
    "Add check-in time": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm giờ điểm danh"
          }
        }
      }
    },
    "Add contact": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm liên hệ"
          }
        }
      }
    },
    "Add emergency contacts": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm liên hệ khẩn cấp"
          }
        }
      }
    },
    "Add me on StillAlive? with code %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mình trên StillAlive? bằng mã %@"
          }
        }
      }
    },
    "Add partner": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm người thân"
          }
        }
      }
    },
    "Add partner by code": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm người thân bằng mã"
          }
        }
      }
    },
    "Add photo": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm ảnh"
          }
        }
      }
    },
    "Add the action Open Check-in (search for StillAlive?).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tác vụ Mở điểm danh (tìm StillAlive?)."
          }
        }
      }
    },
    "Allow camera access for StillAlive? in the Settings app, or type the code instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép StillAlive? dùng camera trong ứng dụng Cài đặt, hoặc nhập mã thay thế."
          }
        }
      }
    },
    "Any mix of apps, for example 3 phone numbers, or 2 phones and a Zalo. Tap an app icon to change it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết hợp tuỳ ý, ví dụ 3 số điện thoại, hoặc 2 số điện thoại và 1 Zalo. Chạm biểu tượng ứng dụng để đổi."
          }
        }
      }
    },
    "App": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng"
          }
        }
      }
    },
    "App: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng: %@"
          }
        }
      }
    },
    "Ask your partner for the code on their Users tab. Spaces and dashes are ignored.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi người thân mã ở thẻ Mọi người của họ. Dấu cách và gạch ngang được bỏ qua."
          }
        }
      }
    },
    "Ask your partner to scan this in StillAlive? (Users → Add partner → Scan QR code), or with the Camera app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhờ người thân quét mã này trong StillAlive? (Mọi người → Thêm người thân → Quét mã QR) hoặc bằng ứng dụng Camera."
          }
        }
      }
    },
    "At %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc %@"
          }
        }
      }
    },
    "At each check-in time an alarm rings. Tap Check in and solve a quick puzzle. Reminder notifications follow until you do.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ điểm danh, báo thức sẽ reo. Chạm Điểm danh và giải một câu đố nhanh. Thông báo nhắc sẽ tiếp tục cho đến khi bạn làm xong."
          }
        }
      }
    },
    "Attach location to check-ins": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đính kèm vị trí khi điểm danh"
          }
        }
      }
    },
    "Attach your approximate location to check-ins. Off by default; you choose which partners see it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đính kèm vị trí gần đúng khi điểm danh. Mặc định tắt; bạn chọn người thân nào được xem."
          }
        }
      }
    },
    "Auto-open": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự mở"
          }
        }
      }
    },
    "Auto-open with Shortcuts": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự mở bằng Phím tắt"
